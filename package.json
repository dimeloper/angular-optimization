{
  "name": "angular-optimization-examples",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:defer": "ng serve --no-hmr",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "serve:ssr:angular-optimization-examples": "node dist/angular-optimization-examples/server/server.mjs",
    "audit:bad-pages": "unlighthouse --site https://ng-pokedex-optimization.netlify.app --urls /pokedex-bad/,/pokemon-bad/ivysaur/,/pokemon-bad/charizard/",
    "audit:optimized-pages": "unlighthouse --site https://ng-pokedex-optimization.netlify.app --urls /pokedex-optimized/,/pokemon-optimized/ivysaur/,/pokemon-optimized/charizard/",
    "bundle-report": "ng build --configuration production --source-map && source-map-explorer dist/*.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,scss}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.24",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/forms": "^21.2.24",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.24",
    "@angular/platform-browser-dynamic": "^21.2.24",
    "@angular/platform-server": "^21.2.24",
    "@angular/router": "^21.2.24",
    "@angular/ssr": "^21.2.24",
    "@netlify/angular-runtime": "^2.1.0",
    "@ngrx/signals": "^21.1.1",
    "express": "^4.18.2",
    "ngx-device-detector": "^11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@analogjs/vitest-angular": "^2.7.5",
    "@angular-devkit/build-angular": "^21.2.24",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@nx/vite": "^20.0.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.10",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.25.1",
    "husky": "^9.1.7",
    "jasmine-core": "~5.1.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.2.5",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.9.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^3.1.2"
  },
  "volta": {
    "node": "24.21.0"
  }
}
